[Unit]
Description=Muse2api online update controller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/muse2api/deploy/update-controller.py
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/muse2api/updater /opt/muse2api/state/updates

[Install]
WantedBy=multi-user.target
